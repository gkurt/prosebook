    "check": "prosebook generate --check && prosebook lint",
    "generate": "prosebook generate"
  },
  "dependencies": {
    "prosebook": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
