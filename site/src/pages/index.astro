---
import '#src/site.css';
import { t } from '#src/copy.ts';
import { fieldsOf, readOf, SAMPLES, START_COUNT } from '#src/demo/samples.ts';
import { view } from '#src/demo/view.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const REPO = 'https://github.com/gkurt/prosebook';
const API = `${REPO}/blob/main/API.md`;
const INSTALL = 'bun add prosebook';

// The demo's first view, made by the tools as the page is built: the same module the browser runs on each edit.
const first = SAMPLES[0]!;
const started = view(first, first.text, START_COUNT);

const samples = [
  { sample: SAMPLES[0]!, label: t('try.sample.error') },
  { sample: SAMPLES[1]!, label: t('try.sample.button') },
  { sample: SAMPLES[2]!, label: t('try.sample.count') },
];

// Names, which read the same in every language.
const works = [
  { label: t('start.frameworks'), names: ['React', 'React Native', 'Preact', 'Vue', 'Svelte', 'Solid'] },
  { label: t('start.bundlers'), names: ['Vite', 'Next.js', 'webpack', 'Rspack', 'Metro', 'Bun', 'Astro'] },
  { label: t('start.native'), names: ['Rust', 'Swift', 'Kotlin', 'Android', 'Apple'] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('site.title')}</title>
    <meta name="description" content={t('site.description')} />
    <meta property="og:title" content={t('site.title')} />
    <meta property="og:description" content={t('site.description')} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <header class="bar wrap">
      <a class="brand" href={base} aria-label={t('site.home')}>
        <img src={`${base}icon.svg`} width="28" height="28" alt="" />
        <span>prosebook</span>
      </a>
      <nav>
        <a href={API}>{t('site.docs')}</a>
        <a href={REPO}>{t('site.github')}</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>{t('hero.title')}</h1>
        <p class="lead">{t('hero.lead')}</p>
        <div class="cta">
          <div class="install">
            <code>{INSTALL}</code>
            <button type="button" data-command={INSTALL} data-copied={t('hero.copied')}>{t('hero.copy')}</button>
          </div>
          <a class="more" href={API}>{t('hero.docs')}</a>
        </div>
      </section>

      <section class="try wrap" id="try">
        <div class="intro">
          <h2>{t('try.title')}</h2>
          <p>{t('try.lead')}</p>
        </div>
        <div class="tabs" role="group" aria-label={t('try.samples')}>
          {
            samples.map(({ sample, label }) => (
              <button type="button" data-sample={sample.id} aria-pressed={sample === first ? 'true' : 'false'}>
                {label}
              </button>
            ))
          }
        </div>
        <div class="sheet">
          <div class="entry">
            <p class="pane">{t('try.entry')}</p>
            {
              SAMPLES.map((sample) => (
                <div class="fields" data-fields={sample.id} hidden={sample !== first}>
                  <div>
                    <span class="key">{sample.key}</span>:
                  </div>
                  {fieldsOf(sample).map(([name, value]) => (
                    <div class="in">
                      <span class="f">{name}</span>: {value}
                    </div>
                  ))}
                  {sample.count !== undefined && (
                    <Fragment>
                      <div class="in">
                        <span class="f">args</span>:
                      </div>
                      <div class="in2">
                        <span class="f">count</span>: {sample.count}
                      </div>
                    </Fragment>
                  )}
                </div>
              ))
            }
            <div class="in text">
              <span><span class="f">en</span>:</span>
              <div class="field">
                <div class="marks" aria-hidden="true" set:html={started.marks} />
                <textarea aria-label={t('try.message')} spellcheck="false" autocomplete="off" autocapitalize="off">{first.text}</textarea>
              </div>
            </div>
          </div>
          <div class="result">
            <p class="pane">{t('try.shown')}</p>
            <code class="read" set:html={readOf(first, START_COUNT)} />
            <p class="shown">{started.shown}</p>
            <label class="counter" hidden>
              <span>count</span>
              <input type="range" min="0" max="12" value={START_COUNT} aria-label={t('try.count')} />
            </label>
            <ul class="notes" aria-live="polite" set:html={started.notes} />
          </div>
        </div>
      </section>

      <section class="features wrap" aria-label={t('features.title')}>
        <article>
          <div class="exhibit editor" aria-hidden="true">
            <div><span class="k">const</span> {'{ t }'} = useCopy();</div>
            <div>t(<span class="s">'cart.</span><span class="caret"></span></div>
            <ul>
              <li class="on"><code>cart.checkout</code><span>Check out</span></li>
              <li><code>cart.failed</code><span>We couldn't take the payment.</span></li>
              <li><code>cart.items</code><span># items in your cart.</span></li>
            </ul>
          </div>
          <h3><a href={`${API}#types`}>{t('features.typed.title')}</a></h3>
          <p>{t('features.typed.body')}</p>
        </article>

        <article>
          <div class="exhibit stale" aria-hidden="true">
            <div><b>en</b><span><del>Check out</del> <ins>Pay now</ins></span></div>
            <div><b>de</b><span>Zur Kasse</span><i>stale</i></div>
            <div><b>fr</b><span>Payer</span><i>stale</i></div>
          </div>
          <h3><a href={`${API}#stale-translations`}>{t('features.stale.title')}</a></h3>
          <p>{t('features.stale.body')}</p>
        </article>

        <article>
          <div class="exhibit size">
            <strong>{t('features.small.size')}</strong>
            <span>{t('features.small.caption')}</span>
          </div>
          <h3><a href={`${API}#pruning`}>{t('features.small.title')}</a></h3>
          <p>{t('features.small.body')}</p>
        </article>

        <article>
          <div class="exhibit mini" aria-hidden="true">
            <div class="app">
              <p class="app-title"><span class="str" data-key="cart.title">Cart</span></p>
              <p><span class="str" data-key="cart.items">3 items in your cart.</span></p>
              <p><span class="str on" data-key="cart.checkout"><span class="app-button">Check out</span></span></p>
            </div>
          </div>
          <h3><a href={`${API}#inspector`}>{t('features.inspector.title')}</a></h3>
          <p>{t('features.inspector.body')}</p>
        </article>
      </section>

      <section class="start wrap">
        <div class="intro">
          <h2>{t('start.title')}</h2>
          <p>{t('start.lead')}</p>
        </div>
        <pre class="commands"><code>{INSTALL}
bunx prosebook init
bunx prosebook generate</code></pre>
        <dl class="works">
          {
            works.map(({ label, names }) => (
              <div>
                <dt>{label}</dt>
                <dd>{names.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
        <div class="cta">
          <a class="button" href={API}>{t('start.reference')}</a>
          <a class="more" href={REPO}>{t('start.source')}</a>
        </div>
      </section>
    </main>

    <footer class="wrap">
      <a href={`${REPO}/blob/main/LICENSE`}>{t('site.license')}</a>
      <a href={REPO}>{t('site.github')}</a>
      <a href="https://gkurt.com">{t('site.author')}</a>
    </footer>

    <script>
      import '#src/demo/client.ts';
    </script>
  </body>
</html>
