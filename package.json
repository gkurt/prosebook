{
  "name": "prosebook",
  "version": "0.17.0",
  "description": "Every string your app shows, in one typed catalog: ICU messages compiled to plain functions, for React, Preact, Vue, Svelte, Solid and any JavaScript.",
  "keywords": [
    "astro",
    "bun",
    "expo",
    "i18n",
    "icu",
    "intl",
    "l10n",
    "localization",
    "messageformat",
    "messageformat2",
    "metro",
    "nextjs",
    "preact",
    "react",
    "react-native",
    "rspack",
    "solid",
    "svelte",
    "translation",
    "typescript",
    "ux-writing",
    "vite",
    "vue",
    "webpack"
  ],
  "homepage": "https://gkurt.com/prosebook/",
  "bugs": {
    "url": "https://github.com/gkurt/prosebook/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/prosebook.git"
  },
  "bin": {
    "prosebook": "./dist/cli.js"
  },
  "workspaces": [
    "examples/*",
    "site"
  ],
  "files": [
    "dist",
    "src",
    "schema",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "prosebook@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "prosebook@dev": "./src/react/index.tsx",
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./react/server": {
      "prosebook@dev": "./src/react/server.ts",
      "import": {
        "types": "./dist/react/server.d.ts",
        "default": "./dist/react/server.js"
      }
    },
    "./preact": {
      "prosebook@dev": "./src/preact/index.ts",
      "import": {
        "types": "./dist/preact/index.d.ts",
        "default": "./dist/preact/index.js"
      }
    },
    "./vue": {
      "prosebook@dev": "./src/vue/index.ts",
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      }
    },
    "./solid": {
      "prosebook@dev": "./src/solid/index.ts",
      "import": {
        "types": "./dist/solid/index.d.ts",
        "default": "./dist/solid/index.js"
      }
    },
    "./svelte": {
      "prosebook@dev": "./src/svelte/index.ts",
      "svelte": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      },
      "import": {
        "types": "./dist/svelte/index.d.ts",
        "default": "./dist/svelte/index.js"
      }
    },
    "./vite": {
      "prosebook@dev": "./src/vite.ts",
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    },
    "./next": {
      "prosebook@dev": "./src/next.ts",
      "default": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    },
    "./webpack": {
      "prosebook@dev": "./src/webpack.ts",
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      }
    },
    "./metro": {
      "prosebook@dev": "./src/metro.ts",
      "default": {
        "types": "./dist/metro.d.ts",
        "default": "./dist/metro.js"
      }
    },
    "./bun": {
      "prosebook@dev": "./src/bun.ts",
      "import": {
        "types": "./dist/bun.d.ts",
        "default": "./dist/bun.js"
      }
    },
    "./astro": {
      "prosebook@dev": "./src/astro.ts",
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      }
    },
    "./config": {
      "prosebook@dev": "./src/tools/config.ts",
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./tools": {
      "prosebook@dev": "./src/tools/index.ts",
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      }
    },
    "./playground": {
      "prosebook@dev": "./src/playground.ts",
      "import": {
        "types": "./dist/playground.d.ts",
        "default": "./dist/playground.js"
      }
    },
    "./ai": {
      "prosebook@dev": "./src/ai.ts",
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test --conditions=prosebook@dev",
    "checks": "bun check && bun typecheck && bun run test",
    "build": "tsdown",
    "prepack": "tsdown",
    "cli": "bun --conditions=prosebook@dev src/cli.ts",
    "example": "tsdown && bun run --cwd examples/vite dev",
    "examples:generate": "tsdown && bun run --filter 'example-*' --filter site generate",
    "examples:smoke": "bun scripts/smoke.mts",
    "size": "bun scripts/size.mts",
    "dev": "tsdown && bun run --cwd site dev",
    "site": "tsdown && bun run --cwd site build",
    "prepare": "husky",
    "tegami": "bun scripts/tegami.mts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "messageformat": "^4.1.0",
    "oxc-parser": "^0.156.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@rspack/core": "^2.3.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7.0.164",
    "astro": "^7.4.5",
    "cldr-core": "48",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "metro": "^0.87.3",
    "metro-config": "^0.87.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "preact": "^11.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.112.2"
  },
  "peerDependencies": {
    "@rspack/core": ">=1",
    "ai": ">=7.0.130",
    "astro": ">=6",
    "metro": ">=0.80",
    "next": ">=16",
    "preact": ">=10",
    "react": ">=18",
    "solid-js": ">=1.8",
    "svelte": ">=5.7",
    "typescript": ">=7",
    "vite": ">=6",
    "vue": ">=3.5",
    "webpack": ">=5"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "metro": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
