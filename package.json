{
  "name": "prosebook",
  "version": "0.3.0",
  "description": "Every string your app shows, in one typed catalog: ICU messages compiled to plain functions, for React and any JavaScript.",
  "keywords": [
    "i18n",
    "icu",
    "intl",
    "l10n",
    "localization",
    "messageformat",
    "messageformat2",
    "react",
    "translation",
    "typescript",
    "ux-writing"
  ],
  "homepage": "https://github.com/gkurt/prosebook",
  "bugs": {
    "url": "https://github.com/gkurt/prosebook/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/prosebook.git"
  },
  "bin": {
    "prosebook": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "prosebook@dev": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "prosebook@dev": "./src/react/index.tsx",
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./vite": {
      "prosebook@dev": "./src/vite.ts",
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    },
    "./config": {
      "prosebook@dev": "./src/tools/config.ts",
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./tools": {
      "prosebook@dev": "./src/tools/index.ts",
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test --conditions=prosebook@dev",
    "checks": "bun check && bun typecheck && bun run test",
    "build": "tsdown",
    "prepack": "tsdown",
    "cli": "bun --conditions=prosebook@dev src/cli.ts",
    "example": "vite examples/react-app",
    "example:build": "vite build examples/react-app",
    "prepare": "husky"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "messageformat": "^4.1.0",
    "oxc-parser": "^0.156.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": ">=7",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
