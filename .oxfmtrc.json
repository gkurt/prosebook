{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "singleQuote": true,
  // Sort within blank-line-separated chunks; never insert blank lines between groups.
  "sortImports": {
    "newlinesBetween": false,
    "partitionByNewline": true
  },
  "ignorePatterns": [
    "**/.claude",
    "**/build",
    "examples/*/src/copy/**",
    "examples/*/dist/**",
    "examples/*/.next/**",
    "examples/*/.output/**",
    "examples/*/.tanstack/**",
    "examples/*/next-env.d.ts",
    "examples/*/src/routeTree.gen.ts",
    "site/src/copy/**",
    "site/.astro/**",
    "**/catalog.schema.json",
    "**/copy/lock.json",
    "prosebook.lock.json",
    "test/.tmp/**"
  ]
}
